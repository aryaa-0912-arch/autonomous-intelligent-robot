<?xml version="1.0"?>
<robot name="autonomous_robot">

  <!-- Main body -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <inertia
        ixx="0.00625" ixy="0.0" ixz="0.0"
        iyy="0.0125" iyz="0.0"
        izz="0.01625"/>
    </inertial>
  </link>

  <!-- Left front wheel -->
  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Right front wheel -->
  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <!-- Left rear wheel -->
  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <!-- Right rear wheel -->
  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </visual>
  </link>

</robot>

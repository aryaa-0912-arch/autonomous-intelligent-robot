<?xml version="1.0"?>
<robot name="autonomous_robot">

  <!-- Main body: 30 cm x 20 cm x 10 cm -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <inertia
        ixx="0.00625" ixy="0.0" ixz="0.0"
        iyy="0.0125" iyz="0.0"
        izz="0.01625"/>
    </inertial>
  </link>

  <!-- Left front wheel -->
  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Right front wheel -->
  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Left rear wheel -->
  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Right rear wheel -->
  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Left front wheel joint -->
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.10 0.115 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right front wheel joint -->
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.10 -0.115 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Left rear wheel joint -->
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.10 0.115 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right rear wheel joint -->
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.10 -0.115 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>
